# Copy this file to `.env` and fill in real values for anything secret.
# In dev, application.yml already defaults to these, so you can run without a .env.
# NEVER commit the real .env — only this .example template.

# --- PostgreSQL ---
# Note: host port 5433 (not 5432) — the Docker Postgres is mapped to 5433 to avoid
# clashing with a native Postgres that may already use 5432.
DB_URL=jdbc:postgresql://localhost:5433/rentflow
DB_USER=rentflow
DB_PASSWORD=rentflow

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# --- Security (fill these when we build auth in Week 1) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Payment gateway (fill when we build payments in Week 3) ---
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
