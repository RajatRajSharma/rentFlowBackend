# Copy this file to `.env` and fill in real values for anything secret.
# In dev, application.yml already defaults to these, so you can run without a .env.
# NEVER commit the real .env — only this .example template.

# --- PostgreSQL ---
# Note: host port 5433 (not 5432) — the Docker Postgres is mapped to 5433 to avoid
# clashing with a native Postgres that may already use 5432.
DB_URL=jdbc:postgresql://localhost:5433/rentflow
DB_USER=rentflow
DB_PASSWORD=rentflow

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# --- Security (fill these when we build auth in Week 1) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Payment gateway ---
# `fake` (the default) needs no keys and no network: it derives a stable reference from
# the idempotency key, so the app runs end to end without a Stripe account.
# Switch to `stripe` to use the real test-mode API — it then REQUIRES STRIPE_API_KEY and
# will refuse to start without one.
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=INR

# Only needed when PAYMENT_GATEWAY=stripe. Get test keys from
# https://dashboard.stripe.com/test/apikeys — the test-mode key starts with `sk_test_`.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Overridden in tests to point at a local WireMock stub.
STRIPE_BASE_URL=https://api.stripe.com
