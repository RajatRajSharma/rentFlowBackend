# Copy this file to `.env` and fill in real values for anything secret.
# In dev, application.yml already defaults to these, so you can run without a .env.
# NEVER commit the real .env — only this .example template.

# --- PostgreSQL ---
# Note: host port 5433 (not 5432) — the Docker Postgres is mapped to 5433 to avoid
# clashing with a native Postgres that may already use 5432.
DB_URL=jdbc:postgresql://localhost:5433/rentflow
DB_USER=rentflow
DB_PASSWORD=rentflow

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ ---
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# --- Security (fill these when we build auth in Week 1) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Payment gateway ---
# `fake` (the default) needs no keys and no network. `stripe` uses the real test-mode API
# and refuses to start without STRIPE_API_KEY.
PAYMENT_GATEWAY=fake
PAYMENT_CURRENCY=INR

# Only needed when PAYMENT_GATEWAY=stripe. Get test keys from
# https://dashboard.stripe.com/test/apikeys — the test-mode key starts with `sk_test_`.
STRIPE_API_KEY=
# From `stripe listen` or the dashboard; starts with `whsec_`. Verification never falls
# back to "allow" when unset — that would let anyone confirm their own bookings for free.
STRIPE_WEBHOOK_SECRET=
# Overridden in tests to point at a local WireMock stub.
STRIPE_BASE_URL=https://api.stripe.com
# Bounded waits: an unbounded read timeout turns a hung Stripe into our outage.
STRIPE_CONNECT_TIMEOUT_MS=3000
STRIPE_READ_TIMEOUT_MS=10000

# The fake signs webhooks with the same HMAC scheme, so local runs exercise real
# verification. Dev-only — this gateway moves no money.
FAKE_WEBHOOK_SECRET=dev-local-webhook-secret-change-me
# How far a webhook's signed timestamp may be from now, in seconds (replay window).
WEBHOOK_TOLERANCE_SECONDS=300

# --- Events & workers ---
# `rabbit` (default) publishes to the broker; `memory` logs instead, for a run with no Rabbit.
EVENTS_PUBLISHER=rabbit
# Set false to stop the @Scheduled sweeps (integration tests do).
WORKERS_ENABLED=true
# How long a payment may sit PENDING before reconciliation asks the gateway about it.
STALE_PAYMENT_MINUTES=15
# How long an owner has to claim damage before the deposit is released for good.
DISPUTE_WINDOW_HOURS=24
